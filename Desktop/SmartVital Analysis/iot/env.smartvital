# ─────────────────────────────────────────────
# SmartVital IoT Environment Config
# ─────────────────────────────────────────────

# Switch between mock and real hardware:
#   mock  → routes through mock_iot_server.py
#   real  → routes through actual ESP32/RPi
IOT_MODE=mock

# Scenario for mock mode:
#   normal | cardiac_risk | diabetic | lung_risk
SCENARIO=normal

# How often (seconds) mock server sends a reading
INTERVAL=2.0

# URL of the standalone mock server (mock_iot_server.py)
MOCK_WS_URL=ws://localhost:8765

# URL of your real ESP32 / Raspberry Pi when IOT_MODE=real
HARDWARE_WS_URL=ws://192.168.1.100/ws
